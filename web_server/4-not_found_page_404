#!/usr/bin/env bash
# Configures Nginx with a custom 404 page

apt-get update -y
apt-get install -y nginx

echo "Holberton School" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html

CONFIG="/etc/nginx/sites-available/default"

if ! grep -q "redirect_me" "$CONFIG"; then
    sed -i '/server_name _;/a\    rewrite ^/redirect_me/?$ https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;' "$CONFIG"
fi

if grep -q "error_page 404" "$CONFIG"; then
    sed -i 's|error_page 404.*;|error_page 404 =404 /404.html;|' "$CONFIG"
else
    sed -i '/server_name _;/a\    error_page 404 =404 /404.html;' "$CONFIG"
fi

nginx -t && service nginx restart
